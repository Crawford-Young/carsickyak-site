# CarsickYak site — environment variables
# Copy to .env.local and fill in real values. .env.local is gitignored.
# All server vars are validated at startup by src/env.ts (t3-env + Zod).

# --- Twitch (live status) ---
# Register an application at https://dev.twitch.tv/console/apps to obtain these.
# Grant type used is client_credentials (app access token) — no user scopes needed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube Data API v3 (video feeds) ---
# Create an API key in the Google Cloud console (https://console.cloud.google.com)
# with the YouTube Data API v3 enabled.
YOUTUBE_API_KEY=
# The @CarsickYak channel id (starts with UC...). Resolve the handle to an id via:
#   GET https://www.googleapis.com/youtube/v3/channels?forHandle=CarsickYak&part=id&key=<YOUTUBE_API_KEY>
YOUTUBE_CHANNEL_ID=
# Optional: a dedicated "covers" playlist id. When unset, cover videos are found
# by scanning recent uploads for /cover/i in the title.
YOUTUBE_COVERS_PLAYLIST_ID=

# --- Sentry (error monitoring) ---
# Optional locally. Data Source Name from your Sentry project settings.
SENTRY_DSN=

# --- App ---
# Local origin. Validated by src/env.ts at startup but NO LONGER drives
# metadataBase — that is pinned to SITE_URL in src/lib/site-routes.ts. Vercel
# held this literal localhost value in production, so every deployed page
# advertised og:url http://localhost:3000 and no gate could see it (locally the
# value is correct). Do not re-wire canonical metadata to this var.
NEXT_PUBLIC_APP_URL=http://localhost:3000
